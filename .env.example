# DEPTHWIZARD AI Configuration
# Team: PARALLAX (Smart India Hackathon)

# Backend Host & Dynamic Port
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Frontend Target API URL (set on Vercel deployment)
VITE_API_URL=https://your-backend-service.onrender.com

# Backend Allowed Origins (CORS)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# AI Model Settings
USE_TORCH_MODEL=True
MODEL_CHECKPOINT_DIR=./models
# Depth Anything V2 weights: depth_anything_v2_vits.pth
MODEL_WEIGHTS_PATH=./models/depth_anything_v2_vits.pth

# Geospatial Default Parameters
DEFAULT_GROUND_SAMPLING_DISTANCE_CM=15.0
DEFAULT_CAMERA_ALTITUDE_METERS=500.0
DEFAULT_VERTICAL_DATUM=WGS84_EGM96

# Storage Paths
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
DEMO_DIR=./demo_assets
