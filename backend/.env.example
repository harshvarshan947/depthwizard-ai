# DepthWizard AI - Backend Environment Configuration
# Team PARALLAX (Smart India Hackathon)

# Server Port (assigned dynamically by Render, Railway, Hugging Face)
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins.
# Note: *.vercel.app is also automatically permitted by origin regex.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# AI Inference Settings
# Depth Anything V2 model architecture & weights
USE_TORCH_MODEL=True
MODEL_CHECKPOINT_DIR=./models
MODEL_WEIGHTS_PATH=./models/depth_anything_v2_vits.pth

# Geospatial Default Parameters
DEFAULT_GROUND_SAMPLING_DISTANCE_CM=15.0
DEFAULT_CAMERA_ALTITUDE_METERS=500.0
DEFAULT_VERTICAL_DATUM=WGS84_EGM96

# Static / Upload Storage Paths
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
DEMO_DIR=./demo_assets
