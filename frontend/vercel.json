{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR-BACKEND-URL.onrender.com/api/$1"
    },
    {
      "source": "/outputs/(.*)",
      "destination": "https://YOUR-BACKEND-URL.onrender.com/outputs/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://YOUR-BACKEND-URL.onrender.com/uploads/$1"
    },
    {
      "source": "/demo_assets/(.*)",
      "destination": "https://YOUR-BACKEND-URL.onrender.com/demo_assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
